_dicttop

_colon	fdb	_semicolon
	fcb	$81
	fcb	$3a		; ':'
__colon	; Are the restore points empty?  Because if they're not, we already have
	;   a set of markers defined.  We don't want to overwrite them.
	tst	complmk
	bne	>
	tst	complmk+1
	bne	>
	tst	complmk+2
	bne	>
	tst	complmk+3
	bne	>
	ldd	dicttop
	std	complmk
	ldd	dsptr
	std	complmk+2
	; Now we can start dealing with compilation.
!	lbsr	__creat		; Create the word
	clr	complst
	inc	complst		; Set compile state
	ldd	dsptr		; Reset dsptr to the beginning of the word's
	subd	#6		;   code field
	std	dsptr
	ldd	dicttop
	pshu	d
	rts

_semicolon
	fdb	_literal
	fcb	$c1
	fcb	$3b		; ';'
__semicolon
	lbsr	___usne
	leau	2,u		; drop the colon-sys
	ldb	#$39		; `RTS` opcode
	stb	[dsptr]		; Store it as the final instruction
	inc	dsptr		;   and update the data space pointer
	; Now we need to clear out the restore markers
	clr	complmk	
	clr	complmk+1
	clr	complmk+2
	clr	complmk+3
	; And return to interpretation state
	clr	complst
	rts

_literal
	fdb	_compilec
	fcb	$c7
	fcv	"literal"
__literal
	lbsr	___usne		; Make sure there's something on the stack
_i_literal
	ldx	dsptr		; Well, we *are* in compile mode, after all…
	ldb	#$cc		; `LDD (immediate)` opcode
	stb	,x+
	pulu	d		; Grab the number
	std	,x++		; and store it as the parameter to `LDD`
	ldd	#$3606		; `PSHU D`
	std	,x++
	stx	dsptr
	rts

_compilec			; compile-comma
	fdb	_lbkt
	fcb	$c8
	fcv	"compile",$2c	; "compile,"
__compilec
	lbsr	___usne		; Make sure there's something on the stack
	; This is going to be using the data space pointer.  Unless we change
	;   the way we're doing things, we'll be appending compiled code to
	;   the location at the data space pointer.  We'll deal with potential
	;   RAM limitations later.
_i_compilec
	ldx	dsptr
	ldb	#$bd		; The opcode for `JSR (extended)`
	stb	,x+		; Put that into the data region
	pulu	d		; Grab the execution address
	std	,x++		;   and store it as the parameter for `JSR`
	stx	dsptr		; Save the new data space pointer
	rts			; We're done here

_lbkt   fdb	_rbkt
	fcb	$c1
	fcb	$1b		; '['
__lbkt	clr	complst
	rts

_rbkt	fdb	_execute
	fcb	$81
	fcb	$1d		; ']'
__rbkt	clr	complst
	inc	complst
	rts	

_execute
	fdb	_find
	fcb	$87
	fcv	"execute"
__execute
	; This should be so ridiculously simple…
	lbsr	___usne		; Make sure we have something on the stack
_i_execute
	pulu	pc		; jump to the address provided

_find	fdb	_state
	fcb	$84
	fcv	"find"
__find	lbsr	___usne		; Make sure we have something on the stack
_i_find	ldx	dicttop		; Get the top of dictionary pointer
	ldy	,u		; Get the search string address
	ldb	,y+		; Get the string length
	bitb	#$f0		; Is it bigger than 16?
	beq	>		; No, skip the error condition
	ldx	#e_tokln	; Yes, token too long error
	swi
!	pshs	b		; We'll need this for comparison
1	ldb	2,x		; Grab the name field header byte
	andb	#$0f		;   and mask off the length field
	cmpb	,s		; Are the lengths the same?
	bne	2f		; Nope, let's move on to the next word
	lda	#$3		; Yes, let's check the word name.  A contains
				;   the current offset in the word name we're
				;   comparing.
	pshs	y		; We'll need to save the start byte of the
				;   search term.
3	ldb	,y+		; Grab the search term character
	pshs	y
	ldy	,u		; A hacky bit:  Are we comparing against the
	cmpy	#toklen		;   token buffer?
	beq	>		; Yes, so skip the character conversion.
	lbsr	___atov		; No, so convert the character to VDGSCII
!	puls	y
	cmpb	a,x		; Does this character match?
	beq	>		; Yes, so let's continue the loop.
	puls	y		; No, so let's reset and go to the next word in
	bra	2f		;   the dictionary.	
!	inca			; Increment our character offset
	ldb	2,s		; Grab our token length and
	addb	#$3		;   offset adjust it for comparison.
	pshs	b
	cmpa	,s+		; Have we reached the end of the token?
	bne	3b		; No, so continue the comparison loop.
	; If we're here, we've found the word.  At this point A contains the
	;   offset to our execution address, which we'll push on the stack as
	;   the execution token.
	leau	2,u		; drop the search term address
	puls	y,b		; get rid of the search term byte count and
				;   search term start byte
	leay	a,x		; Put the found execution address in Y and
	pshu	y		;   push it onto the parameter stack.
	clra			; We'll start by assuming the word we found is
	ldb	#1		xt;   immediate or compile-only.
	pshu	d
	ldb	#$50		; This is the immediate or compile-only mask.
	bitb	2,x		; Is it actually immediate or compile-only?
	bne	>		; Yes, so we don't have to do any flippery.
	lbsr	_i_ngte		; No, so we change that to -1.
!	rts			; Let's go home now.
	; If we're here, we've failed to match the search term with the current
	;   dictionary word.
2	ldx	,x		; Get the next dictionary entry
	beq	>		; If we're at the end, let's get out of here.
	bra	1b		; Otherwise, we compare the next entry.
	; If we're here, the search has failed.
!	clra
	clrb
	pshu	d		; Push a zero onto the parameter stack,
	puls	b		;   clean up,
	rts			;   and go home.

_state	fdb	_words
	fcb	$85
	fcv	"state"
__state	clra
	ldx	#complst	; Get our state flag location
	ldb	,x+		; Get the state flag itself
	std	,x		; Store it in the mirror
	pshu	x		; Push the state flag mirror location
	rts

_words	fdb	_and
	fcb	$85
	fcv	"words"
__words	ldx	dicttop		; Well, there's going to be at least one, right?
	pshs	x		; We'll be needing the X register available
	; We could reuse `type`, but it expects an ASCII string.  Our dictionary
	;   entries are encoded in VDGSCII.  It may not be the most space-
	;   efficient, but it'll be easier to duplicate code than to refactor
	;   (at least for now—we'll do refactoring later)
	; `type` fails to do a proper scroll check.  We *must* do a scroll
	;   check in `words` because we'll `definitely` be overflowing the
	;   screen buffer at some point in the dump.  Let's prepare for that
	;   by ensuring our output cursor is in Y (after all, that's what
	;   `scrlchk` looks at)
	ldy	prtcrsr
1	ldb	#$20
	stb	,y+		; Prefix a space
	lda	2,x		; Grab the word name length and
	anda	#$0f		;   mask it off.
	leax	3,x		; Point X to the word name
2	tsta			; Have we hit the end of the string?
	beq	3f		; Yes, we're done.
	ldb	,x+		; No, so let's get the character,
	deca			;   decrement our counter,
	stb	,y+		;   and put the character on the screen.
	bra	2b		; Next character, please!
3	lbsr	scrlchk		; Handle the scroll if we need to
	ldx	[,s]		; Do we have another dictionary entry?
	beq	4f		; Nope, let's get out of here.
	stx	,s		; Yep, so save the new entry location
	bra	1b		;   and keep going.
4	sty	prtcrsr		; We're done.  Save the new cursor location,
	puls	x		;   clean up the stack,
	rts			;   and go home.


_and	fdb	_or
	fcb	$83
	fcv	"and"
__and	lbsr	__depth
	pulu	d
	cmpb	#$02
	bhs	>
	ldx	#e_stkdp
	swi
!	pulu	d
	anda	,u
	andb	,u+1
	std	,u
	rts

_or	fdb	_xor
	fcb	$82
	fcv	"or"
__or	lbsr	__depth
	pulu	d
	cmpb	#$02
	bhs	>
	ldx	#e_stkdp
	swi
!	pulu	d
	ora	,u
	orb	,u+1
	std	,u
	rts

_xor	fdb	_smsrem
	fcb	$83
	fcv	"xor"
__xor	lbsr	__depth
	pulu	d
	cmpb	#$02
	bhs	>
	ldx	#e_stkdp
	swi
!	pulu	d
	eora	,u
	eorb	,u+1
	std	,u
	rts

	; Symmetric divide double-cell by single-cell, leave remainder
	; in NOS and quotient in TOS
_smsrem	fdb	_stod
	fcb	$86
	fcv	"sm",$2f,"rem"
__smsrm	lbsr	__depth
	pulu	d
	cmpb	#$03		; We need three items
	bhs	>
	ldx	#e_stkdp	; If we don't have 'em, error out.
	swi
!	; For internal use
_i_smsr	ldd	,u		; Grab the divisor
	bne	>		; If it's zero, we error out.
	ldx	#e_div0		; Signal a divide by zero error.
	swi
!	; check for signedness
	clr	numflgs
	lbsr	___scks		; Check for divisor signedness
	leau	2,u
	lbsr	___sckd		; Check for dividend signedness
	leau	-2,u
	; If we need an internal entry point, it should be here.
	tfr	s,x		; Set up our tempvar frame
	leas	-3,s
	clr	-1,x
	clr	-2,x		; -2,x will be the quotient
	clr	-3,x		; -3,x will be the shift count
	lbsr	_i_stod		; Bit-match our quotient
!	; If the divisor is less than the dividend, shift one left and
	; increase the shift count.  Otherwise move to the division process.
	ldd	,u
	cmpd	4,u
	bhi	2f		; MSW NOS > MSW TOS: divisor bigger
	blo	1f		; MSW NOS < MSW TOS: divisor smaller
	; If we're here, MSW NOS == MSW TOS
	ldd	2,u
	cmpd	6,u
	bhi	2f		; LSW NOS >= LSW TOS: divisor bigger
1	; If we're here, we need to shift the divisor left one and
	; try again.
	lsl	3,u
	rol	2,u
	rol	1,u
	rol	,u
	inc	-3,x
	bra	<
2	; If we're here, the divisor is now bigger than the dividend.  If the
	; shift count is zero we skip to remainder handling.
	ldb	-3,x
	beq	3f
	; Check for quotient overflow.
	cmpb	#$0f		; Have we overflowed the quotient?
	blo	>		; Nope, we can continue on.
	bra	4f		; Yes, throw the error condition.
!	; If we're here, we do the division step.
	lsr	,u
	ror	1,u
	ror	2,u
	ror	3,u		; Shift the divisor right one
	lsl	-1,x
	rol	-2,x		; Shift the quotient left one
	dec	-3,x		; And decrement the shift count.
	; If the divisor is bigger than the dividend we move to the next
	; place.
	ldd	,u
	cmpd	4,u
	bhi	2b		; MSW NOS > MSW TOS: divisor bigger
	blo	>		; MSW NOS < MSW TOS: divisor smaller
	; If we're here, MSW NOS == MSW TOS
	ldd	2,u
	cmpd	6,u
	bhi	2b		; LSW NOS >= LSW TOS: divisor bigger
!	; If we're here, we need to do the subtraction.
	ldd 	6,u
	subd 	2,u
	std 	6,u
	ldd 	4,u
	bcc	>
	subd 	#1
!	subd 	,u
	std	4,u
	; Now increment the quotient
	ldd	-2,x
	addd	#1
	std	-2,x
	; We're done with the division step, move to the next place.
	bra	2b
3	; If we're here, we're done with the division.  Our remainder
	; is the double-word NOS (it *was* the dividend).  It *should*
	; be <= $7FFF, otherwise we have a remainder overflow.
	ldd	4,u		; Is the remainder bigger than $FFFF?
	beq	>		; No, continue the check.
	bra	4f		; Yes, throw the error condition.
!	ldd	6,u		; Is the remainder bigger than $7FFF?
	bmi	4f		; Yes, throw the error condition.
	; If we're here, both the quotient and remainder are fine.
	leau	6,u		; Remainder is now TOS
	ldd	-2,x
	pshu	d		; Quotient now TOS, remainder now NOS
	ldb	numflgs
	bitb	#f_sgn		; Is the resultant negative?
	beq	>		; No, we skip over negation.
	leau	2,u
	lbsr	_i_ngte		; Negate the remainder
	leau	-2,u
	lbsr	_i_ngte		; Negate the quotient
!	clr	numflgs		; Clean up and go home
	leas	3,s
	rts
4	clr	numflgs
	ldx	#e_mulof	; Something overflowed.
	swi

	; Convert a single-cell number to a double-cell number
_stod	fdb	_rfrom
	fcb	$83
	fcv	"s",$3e,"d"
__stod	cmpu	#prmstk		; Do we have something on the stack?
	blo	>		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	; We will use this internally
_i_stod	clr	,-u
	clr	,-u
	tst	2,u		; Is this a negative number?
	bpl	>		; No, skip the sign extension
	com	,u
	com	1,u		; Sign-extend the MSB
!	rts

	; Move the top of the return stack to TOS
_rfrom	fdb	_tor
	fcb	$d2
	fcv	"r",$3e		; `R>`
__rfrom	; We will use this internally
_i_rfrm	puls	d
	pshu	d
	rts

	; Move TOS to the top of the return stack
_tor	fdb	_dnegat
	fcb	$d2
	fcv	$3e,"r"		; `>R`
__tor	cmpu	#prmstk		; Do we have something on the stack?
	blo	>		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	; We will use this internally
_i_tor	pulu	d
	pshs	d
	rts

	; Negate a double-cell number
_dnegat	fdb	_deciml
	fcb	$87
	fcv	"dnegate"
__dngat	cmpu	#prmstk		; Do we have something on the stack?
	blo	>		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	; We will use this internally
_i_dngt	com 	,u
	com	1,u
	com	2,u
	com	3,u		; Bitwise negate the double-word
	inc	3,u		; and do the increment.
	bne	>
	inc	2,u
	bne	>
	inc	1,u
	bne	>
	inc	,u
!	rts

	; Set the radix to decimal
_deciml	fdb	_hex
	fcb	$87
	fcv	"decimal"
__decml	lda	#10
	sta	radix
	rts

	; Set the radix to hexadecimal
_hex	fdb	_negate
	fcb	$83
	fcv	"hex"
__hex	lda	#$10
	sta	radix
	rts

	; Two's compliment negation
_negate	fdb	_invert
	fcb	$86
	fcv	"negate"
__ngte	cmpu	#prmstk		; Do we have something on the stack?
	blo	>		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	; We will use this internally
_i_ngte	com	,u		; invert the bits
	com	1,u
	inc	1,u		; increment
	bne	>
	inc	,u
!	rts

	; Bitwise NOT
_invert	fdb	_move
	fcb	$86
	fcv	"invert"
__invrt	cmpu	#prmstk		; Do we have something on the stack?
	blo	>		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	com	,u		; invert the bits
	com	1,u
	rts

_move	fdb	_char
	fcb	$84
	fcv	"move"
__move	lbsr	__depth
	pulu	d
	cmpb	#$03		; We need three items
	bhs	>
	ldx	#e_stkdp	; If we don't have 'em, error out.
	swi
	; 0,U(D): the byte count to be transferred
	; 2,U(X): the destination address
	; 4,U(Y): the source address
!	pulu	d,x,y		; Get our parameters
1	tstb			; Has the count LSB hit zero?
	bne	>		; No, skip over this next bit.
	tsta			; Has the count MSB hit zero?
	beq	2f		; Yes, we're done.
	deca			; No, so roll count MSB back one
!	decb			; Roll count LSB back one
	pshs	b		; Move the data over
	ldb	,y+
	stb	,x+
	puls	b
	bra	1b		; Get the next byte
2	rts


_char	fdb	_twodup
	fcb	$84
	fcv	"char"
__char	ldx	tscrsr		; Get the current token stream pos'n
	ldy	#tokbuf		; Get the token buffer
	lda	#$20		; Skip any leading spaces
1	cmpx	curcrsr		; Are we at the end of the input line?
	bne	>		; No, let's keep going.
	ldx	#e_mttok	; Yes, so emit the error condition.
	swi
!	cmpa	,x+		; Are we at the beginning of a token?
	beq	1b		; No, keep trying.
	leax	-1,x		; Back up one 'cause we've overshot
1	ldb	,x+		; Load the character
	stb	,y+		; Put it in the token buffer
	cmpy	#tokbuf+$10	; Have we overflowed the token buffer?
	bne	>		; No, keep going.
	ldx	#e_tokln	; Yes, trigger the error.
	swi
!	cmpx	curcrsr		; Are we at the current cursor location?
	beq	>		; Yes, get that first character
	cmpa	,x		; Have we come to a space yet?
	beq	>		; Yes, get that first character
	bra	1b		; If we're here, we have more characters
!	stx	tscrsr		; If we're here, we're grabbing the character
	lda	tokbuf		; Get the first character in the token buffer
	lbsr	___vtoa		; Translate to ASCII
	exg	b,a
	clra			; Set it up for the parameter stack
	pshu	d		; return the ASCII value
	rts

_twodup	fdb	_type
	fcb	$84
	fcv	$32,"dup"
__twodup
	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have less than two parameters?
	bhs	>		; No, we can keep going
	ldx	#e_stkdp	; Signal a stack depth error
	swi
!	ldd	+2,u
	pshu	d
	ldd	2,u
	pshu	d
	rts

_type	fdb	_count
	fcb	$84
	fcv	"type"
__type	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have less than two parameters?
	bhs	>		; No, we can keep going
	ldx	#e_stkdp	; Signal a stack depth error
	swi
	; todo: perform scroll check every 32 characters
!	ldy	prtcrsr		; Grab our output cursor position
	ldb	#$20
	stb	,y+		; Prefix output with a space
	pulu	x,d		; Grab our character count and data pointer
	exg	a,b		; We use B for character data
!	tsta			; Have we hit the end of the string?
	beq	>		; Yes, we're done.
	ldb	,x+		; No, so let's get the character,
	deca			; decrement our counter,
	lbsr	___atov		; translate the character to VDGSCII,
	stb	,y+		; and put it on the screen.
	bra	<		; Next character, please.
!	sty	prtcrsr		; Update the output cursor location
	rts			; and go home.

	bra	<		; And loop back.
!	rts			; We're done, let's go home.

_count	fdb	_word
	fcb	$85
	fcv	"count"
__count	lbsr	___usne		; Make sure we have something on the stack
	pulu	x		; Get the counted string address
	ldb	,x+		; Get the character count and point X to the
	clra			; beginning of string data.
	pshu	d,x		; Put the data on the stack
	rts

_word	fdb	_bl
	fcb	$84
	fcv	"word"
__word	lbsr	___usne		; Make sure we have something on the stack
	ldx	tscrsr		
	leax	1,x		; Consume the token parser's final delimiter
	ldy	#wrdbuf		; Get the word buffer into Y
	clr	,y+		; Zero the count byte
	pulu	d		; Get the delimiter character into B and
	lbsr	___atov		; translate it to VDGSCII
1	cmpx	curcrsr		; Are we at the end of the input line?
	bne	>		; No, let's keep going.
	ldx	#e_mttok	; Yes, so emit the error condition.
	swi
!	cmpb	,x+		; Have we passed opening delimiters?
	beq	1b		; Nope, so keep trying.
	leax	-1,x		; Back up one 'cause we've overshot
1	cmpy	#scrtop		; Have we overflowed the buffer?
	bne	>		; No, keep going.
	ldx	#e_tokln	; Yes, trigger the overflow error.
	swi
!	lda	,x+		; Load the character
	lbsr	___vtoa		; translate the character to ASCII
2	sta	,y+		; Put it in the word buffer
	inc	wrdbuf		; Increment the character counter
	cmpx	curcrsr		; Are we at the current cursor location?
	beq	>		; Yes, we're implicitly done.
	cmpb	,x		; Have we hit the closing delimiter?
	beq	>		; Yes, we're done.
	bra	1b		; No, we have more characters, loop back.
	; If we're here, we're saving the string.
!	leax	1,x		; Consume the ending delimiter
	stx	tscrsr		; and save the token stream location
	ldd	#wrdbuf		; Return the word buffer location
	pshu	d		; in the parameter stack
	rts			; and go home.

_bl	fdb	_emit
	fcb	$82
	fcv	"bl"
__bl	ldd	#$20
	pshu	d
	rts

_emit	; Don't forget to add in HT, CR, and LF
	fdb	_constant
	fcb	$84
	fcv	"emit"
__emit	lbsr	___usne		; Make sure the stack isn't empty
	pulu	d
	ldy	prtcrsr
	lbsr	___atov
8	lda	#$20		; Put a space in front of the output
	sta	,y+
	stb	,y+
	sty	prtcrsr
9	rts


_constant
	fdb	_variable
	fcb	$88
	fcv	"constant"
__constant
	lbsr	___usne
	lbsr	__creat
	ldd	dsptr
	subd	#$5
	tfr	d,x
	pulu	d
	std	,x
	rts

_variable
	fdb	_create
	fcb	$88
	fcv	"variable"
__variable
	bsr	__creat
	ldd	#$2
	addd	dsptr
	std	dsptr
	rts

_create	fdb	_allot
	fcb	$86
	fcv	"create"
__creat	ldx	tscrsr		; Get the current token stream pos'n
	ldy	#tokbuf		; Get the token buffer
	lda	#$20		; Skip any leading spaces
1	cmpx	curcrsr		; Are we at the end of the input line?
	bne	>		; No, let's keep going.
	ldx	#e_mttok	; Yes, so emit the error condition.
	swi
!	cmpa	,x+		; Are we at the beginning of a token?
	beq	1b		; No, keep trying.
	leax	-1,x		; Back up one 'cause we've overshot
1	ldb	,x+		; Load the character
	stb	,y+		; Put it in the token buffer
	cmpy	#tokbuf+$10	; Have we overflowed the token buffer?
	bne	>		; No, keep going.
	ldx	#e_tokln	; Yes, trigger the error.
	swi
!	cmpx	curcrsr		; Are we at the current cursor location?
	beq	>		; Yes, create the word
	cmpa	,x		; Have we come to a space yet?
	beq	>		; Yes, create the word
	bra	1b		; If we're here, we have more characters
!	stx	tscrsr		; If we're here, we're creating the word
	; Store the location of the most recent dictionary word
	ldx	dsptr		; dsptr will become our new dicttop, so
	ldd	dicttop		; we store dicttop in the new word's
	std	,x		; link field area and dsptr becomes
	stx	dicttop		; our new dicttop.
	; Calculate and store the name field preamble
	leax	2,x		; Advance to the name field.
	tfr	y,d		; Get the end of token location
	subd	#tokbuf		; and determine the length of the token.
	andb	#$0f		; mask off the word name length,
	orb	#$80		; mark the word as an interpretable word,
	stb	,x+		; store the name field preamble,
	andb	#$0f		; restore only a length,
	pshs	b		; save it for later,
	decb			; and adjust for offset calculation.
	; Store the new word's name
	ldy	#tokbuf		; Set Y to the beginning of the token buffer
!	lda	b,y		; Get the word name character
	sta	b,x		; and store it in the name field.
	decb			; Let's get the next character
	bpl	<		; Unless we've come to the end.
	; Store the word's code
	puls	b		; Get the word name length back and
	leax	b,x		; get X pointing to the code field
	ldb	#$cc		; LDD immediate opcode
	stb	,x+		; That's the first byte of our word code
	tfr	x,d		; We'll be needing the location where the
	addd	#$5		; data pointer *will* be after the code field.
	std	,x++		; Store the parameter of LDD immediate
	ldd	#$3606		; PSHU D opcode
	std	,x++		; Store it
	ldb	#$39		; rts opcode
	stb	,x+		; Store it
	stx	dsptr		; Update the data space pointer
	rts

_allot	fdb	_cellp
	fcb	$85
	fcv	"allot"
__allot	lbsr	___usne
	pulu	d
	addd	dsptr
	std	dsptr
	rts
	
_cellp	fdb	_cells
	fcb	$85
	fcv	"cell",$2b
__cellp	lbsr	___usne
	ldd	,u		
	addd	#2		; The cell size is two bytes, after all
	std	,u		; update the value
	rts

_cells	fdb	_fetch
	fcb	$85
	fcv	"cells"
__cells	lbsr	___usne
	lsl	1,u		; multiply the low byte by 2
	rol	,u		; multiply the high byte by 2 carrying in
	rts

_fetch	fdb	_store
	fcb	$81
	fcb	$00		;'@'
__fetch	lbsr	___usne
	ldd	[,u]		; Grab the value from memory
	std	,u		; Replace the address with the value
	rts

_store	fdb	_here
	fcb	$81
	fcb	$21		;'!'
__store	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have enough on the stack?
	bhs	>		; Yes, keep going
	ldx	#e_stkdp	; Yes, signal a stack depth error.
	swi
!	ldd	2,u		; Grab the value we're going to store
	std	[,u]		; Store it in the provided location
	leau	4,u		; dump the parameter stack
	rts

_here	fdb	_dup
	fcb	$84
	fcv	"here"
__here	ldd	dsptr		; Get the current data space pointer
	pshu	d		; and put it on the parameter stack.
	rts

_dup	fdb	_dropn
	fcb	$83
	fcb	$04,$15,$10	; 'DUP'
__dup	lbsr	___usne
	ldd	,u		; Grab the TOS value
	pshu	d		; and duplicate it
	rts

_dropn	fdb	_mstar
	fcb	$85
	fcb	$04,$12,$0f,$10,$0e
		; 'DROPN'
__dropn	lbsr	__depth
	pulu	d		; Grab the current stack depth
	cmpb	#$02		; Stack depth < 2 is nonsensical
	blo	1f		; If that's the case, error out
	subd	#$01		; Adjust for depth of stack excluding parameter
	cmpd	,u		; Are we asking for more than we have?
	blo	1f		; Yes, process the error
	pulu	d		; No, drop the stack
	leau	d,u
	leau	d,u
	bra	2f
1	ldx	#e_stkdp	; Signal a stack depth error
	swi
2	rts			; and go home.

_mstar	fdb	_star
	fcb	$82
	fcv	"m",$2a
__mstar	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have enough on the stack?
	bhs	>		; Yes, keep going
	ldx	#e_stkdp	; Yes, signal a stack depth error.
	swi
!	; Check for signedness
	clr	numflgs
	lbsr	___scks		; Check for TOS signedness
	leau	2,u
	lbsr	___scks		; Check for NOS signedness
	leau	-2,u		; restore the parameter stack
_i_mstr	; Prepare our temporary storage area
	clra
	clrb
	std	-2,s
	std	-4,s
	; Multiply the LSBs of TOS and NOS
	lda	1,u
	ldb	3,u
	mul
	std	-2,s		; Store this result
	; Multiply the LSB of TOS with MSB of NOS (result shifts one byte left)
	lda	1,u
	ldb	2,u
	mul
	addd	-3,s		; Add the shifted value to our result
	std	-3,s		; and store
	; Multiply the MSB of TOS with LSB of NOS (result shifts one byte left)
	lda	,u
	ldb	3,u
	mul
	addd	-3,s		; Add the shifted value to our result
	std	-3,s		; and store
	; Multiply the MSB of TOS with MSB of NOS (result shifts two bytes left)
	lda	,u
	ldb	2,u
	mul
	addd	-4,s		; Add the shifted value to our result
	; Transfer to parameter stack:
	std	,u		; MSW to TOS
	ldd	-2,s
	std	2,u		; LSW to NOS
	; At this point we have a guaranteed >=0 double-cell number.
	ldb	numflgs
	bitb	#f_sgn		; Is the number negative?
	beq	>		; No, we skip over negation
	lbsr	_i_dngt
!	clr	numflgs
	rts

_star	fdb	_slash
	fcb	$81
	fcb	$2a		; '*'
__star	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have enough on the stack?
	bhs	>		; Yes, keep going
	ldx	#e_stkdp	; Yes, signal a stack depth error.
	swi
!	clr	numflgs		; We don't need to sign extend
	bsr	_i_mstr
	leau	2,u
	rts

_slash	fdb	_swap
	fcb	$81
	fcb	$2f
__slash	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have two parameters?
	bhs	>		; Yes, continue on.
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	; Make sure the dividend has been transformed to a double-cell number
	pulu	d
	pshs	d
	lbsr	_i_stod
	puls	d
	pshu	d
	; Call `sm/rem`—it'll handle sign checking and whatnot
	lbsr	_i_smsr
	; Perform a swapdrop
	pulu	x,y
	pshu	x
	rts

_swap	fdb	_sub
	fcb	$84
	fcb	$13,$17,$01,$10
__swap	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have two parameters?
	bhs	>		; Yes, continue on.
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	pulu	x,y
	exg	x,y
	pshu	x,y
	rts

_sub	fdb	_drop
	fcb	$81
	fcb	$2d
__sub	lbsr	__depth
	pulu	d
	cmpb	#$02		; Do we have two parameters?
	bhs	>		; Yes, continue on.
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	pulu	x		; Get the minuend into D and the subtrahend
	pulu	d		; on the stack
	pshu	x
	subb	1,u		; Subtract the LSB
	sbca	,u		; Subtract the MSB
	std	,u		; Put the result on the parameter stack
	rts

_drop	fdb	_base
	fcb	$84
	fcb	$04,$12,$0f,$10
__drop	lbsr	___usne
	leau	2,u		; Drop the stack
	rts

_base	fdb	_dot
	fcb	$84
	fcb	$02,$01,$13,$05
__base	ldd	#radix-1	; Get the cell-aligned address of the radix
	pshu	d		; and drop it on the stack
	rts

_dot	fdb	_udot
	fcb	$81
	fcb	$2e		; '.'
	; Step 0: Do the radix check
__dot	lbsr	___rdck
	; Step 1: Check the stack depth
	cmpu	#prmstk		; Do we have something on the stack?
	blo	>		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	; Step 2: If the number is negative, let's print the negative sign and
	; negate the number for printing.
	tst	,u		; Are we negative?
	bpl	>		; No, skip negation
	ldx	prtcrsr		; Yes, print the negative sign
	lda	#$20
	sta	,x+
	lda	#$6d
	sta	,x
	stx	prtcrsr
	lbsr	__ngte		; Negate the value
!	bra	__d_udt		; Go to the digit printing

_udot	fdb	_add
	fcb	$82
	fcv	"u",$2e		; 'U.'
	; Step 0: Do the radix check
__udot	lbsr	___rdck
	; Step 1: Check the stack depth
	cmpu	#prmstk		; Do we have something on the stack?
	blo	__d_udt		; Yes, skip the error condition
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
	; Step 2: Set up local variables
_d_pow	equ	$3		; The radix powers offset
_d_dgf	equ	$1		; The digit found flag
_d_itr	equ	$0		; The inner loop iteration counter
_d_lvsz	equ	-$22		; Bytes to reserve for the local variables
_d_npow	equ	$10		; How many powers we're calculating
__d_udt	leax	,s		; Allocate temporary storage in the stack for
	leas	_d_lvsz,s	; radix powers and flags.
	; Step 3: Prepare for output
	ldy	prtcrsr		; Set up to output
	lda	#$6d		
	cmpa	,y		; Do we have a negative sign?
	beq	>		; Yes, so skip placing the space
	lda	#$20		; No, so place a space
	sta	,y		
!	leay	1,y
	; Step 4: calculate the radix powers
	; - Start radix power calculation here
	ldb	radix		; Let's find our maximum divisor for our
	clra			; assigned radix
3	std	,--x		; We'll have at least one digit to display.
	; - Calculate the next power of the radix
	pshu	d
	clra
	ldb	radix
	pshu	d
	lbsr	_i_mstr
	ldd	,u++		; Get the MSW from the multiplication
	bne	_d_pwdn		; If it's non-zero, we've overflowed		
	pulu	d		; We haven't, so calculate the next power.
	bra	3b
	; - Recover from the multiplicative overflow
_d_pwdn	leau	2,u		; Dump the parameter stack,
	; Step 6: Calculate and display the digits.
	clr	_d_dgf,s
	; - This is the outer loop, printing (or not) each digit
4	tfr	s,d		; Get the end of the divisor list.
	addd	#-_d_lvsz
	pshs	d
	cmpx	,s++		; Are we there?
	beq	5f		; Yes, head to the finish-up.
	clr	_d_itr,s	; no, clear the iteration counter and keep going
	; This is the inner loop, calculating each digit.
	ldd	,u		; Grab the original number
!	subd	,x		; Subtract the power
	bcs	6f		; We've gone over, so we need to back up one
	inc	_d_itr,s	; Increment the iteration counter
	inc	_d_dgf,s	; Set the we've found a digit flag
	bra	<		; and let's try another round.
6	addd	,x++		; Restore the number for the next power
	std	,u		; and put it back where we got it.
	tst	_d_dgf,s	; Did we find a digit?
	beq	4b		; No, skip the print cycle.
	; - If we're here, we've found a digit, and need to print every digit
	;   hereafter.  The value of the digit is in the iteration counter.
	;   We need to adjust this to the appropriate VDGscii character.
	lda	#$01
	sta	_d_dgf,s	; Make sure we see the next digit
	lda	_d_itr,s	; Grab the digit value
	cmpa	#9		; Do we have a digit >9?
	bhi	>		; Yes, skip the <=9 digit bit
	adda	#$70		; We're going with inverse video for output
	bra	7f		; Skip over >9 digit bit
!	adda	#$40-$9		; Adjust for inverse video A-Z
7	sta	,y+		; Print the character
	bra	4b		; Head back to the beginning of the outer loop
	; - If we're here, we're done with the outer loop.  We need to print the
	;   final digit.
5	pulu	d		; Grab the ones place number
	cmpb	#9		; Do we have a digit >9?
	bhi	>		; Yes, skip the <=9 digit bit
	addb	#$70		; We're going with inverse video for output
	bra	8f		; Skip over >9 digit bit
!	addb	#$40-$9
8	stb	,y+
	sty	prtcrsr		; Save the output cursor location.
	; Step 7: clean up and go home.
	leas	-_d_lvsz,s	; Release the local variables
	rts


_add	fdb	_depth
	fcb	$81
	fcb	$2b		; '+'
__add	bsr	__depth
	pulu	d
	cmpb	#$02		; Do we have two parameters?
	bhs	>		; Yes, continue on.
	ldx	#e_stkdp	; No, Signal a stack depth error.
	swi
!	pulu	d
	addd	,u++
	pshu	d
	rts


_depth	fdb	$0000		; The link field
	fcb	$85		; The name field header
		; The name of the word: "DEPTH"
	fcb	$04,$05,$10,$14,$08
__depth	tfr	u,d		; We need to do math on the parameter stack loc
	subd	#prmstk		; The number of bytes, but negated
	comb			; Calculating two's complement is a simple
	coma			; bitwise negation followed by an increment.
	addd	#$01		; We use add because we need the carry flag.
	asra			; But we're counting words, not bytes
	rorb			; so divide by two for the true count
	pshu	d
	rts
